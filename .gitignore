# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Master media. Re-encoded into public/media by "npm run media";
# only the encoded output belongs in the repository.
media-src/

# local dev server log
dev.log

# Payload's local-disk media storage — placeholder until Cloudflare R2 is
# wired in; never belongs in the repo either way.
media-uploads/
